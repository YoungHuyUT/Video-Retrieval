# ===========================================================================
# .env.example - mau bien moi truong.
# Copy thanh .env roi chinh:  cp .env.example .env
# .env da bi .gitignore + .dockerignore -> khong lo commit/lo vao image.
#
# API doc .env qua python-dotenv (load_dotenv trong api.py / cli.py).
# ===========================================================================

# --- HuggingFace model cache (named volume trong compose) ---
HF_HOME=/home/app/.cache/huggingface
TRANSFORMERS_CACHE=/home/app/.cache/huggingface

# --- Optional: Gemini API (mac dinh TAT trong code, chi can khi bat feature) ---
# GEMINI_API_KEY=

# --- Optional: Ollama (chi can khi dung profile llm) ---
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b

# --- API / UI ---
API_PORT=8000
UI_PORT=8501
